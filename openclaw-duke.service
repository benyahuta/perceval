[Unit]
Description=OpenClaw Duke - Event Tracker for Duke University
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/openclaw-duke
ExecStart=/home/ubuntu/openclaw-duke/venv/bin/python main.py
Restart=always
RestartSec=30
EnvironmentFile=/home/ubuntu/openclaw-duke/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-duke

[Install]
WantedBy=multi-user.target
